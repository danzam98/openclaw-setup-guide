      "mode": "socket",
      "webhookPath": "/slack/events",
      "userTokenReadOnly": true,
      "groupPolicy": "open"
    }
  },
  "gateway": {
    "mode": "local"
  },
  "plugins": {
    "entries": {
      "google-gemini-cli-auth": {
        "enabled": true
      },
      "slack": {
        "enabled": true
      }
    }
  },
  "memory": {
    "backend": "qmd",
    "qmd": {
      "includeDefaultMemory": true,
      "sessions": {
        "enabled": true,
        "retentionDays": 30
      },
      "update": {
        "interval": "5m",
        "onBoot": true
      },
      "limits": {
        "maxResults": 10,
        "maxSnippetChars": 700,
        "maxInjectedChars": 4000,
        "timeoutMs": 5000
      }
    }
  },
  "tools": {
    "agentToAgent": {
      "enabled": true,
      "allow": ["main", "planner", "developer", "researcher", "qa-reviewer", "devops", "image-generator"]
    },
    "sandbox": {
      "tools": {
        "allow": [
          "exec",
          "process",
          "read",
          "write",
          "edit",
          "apply_patch",
          "sessions_list",
          "sessions_history",
          "sessions_send",
          "sessions_spawn",
          "session_status"
        ],
        "deny": [
          "browser",
          "canvas",
          "nodes",
          "cron",
          "gateway",
          "telegram",
          "whatsapp",
          "discord",
          "googlechat",
          "signal",
          "imessage",
          "slack"
        ]
      }
    }
  }
