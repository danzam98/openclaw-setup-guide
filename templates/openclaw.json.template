            "reasoning": true,
            "input": ["text"],
            "cost": {
              "input": 1e-07,
              "output": 4e-07,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 1048576,
            "maxTokens": 65536
          },
          {
            "id": "google/gemini-2.5-flash-medium",
            "name": "Gemini 2.5 Flash (Medium Thinking)",
            "reasoning": true,
            "input": ["text"],
            "cost": {
              "input": 1e-07,
              "output": 4e-07,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 1048576,
            "maxTokens": 65536
          },
          {
            "id": "google/gemini-2.5-flash-high",
            "name": "Gemini 2.5 Flash (High Thinking)",
            "reasoning": true,
            "input": ["text"],
            "cost": {
              "input": 1e-07,
              "output": 4e-07,
